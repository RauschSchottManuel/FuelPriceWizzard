server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Forward API calls to the FuelPriceWizard.API container.
    # The API serves its routes under /api, so the URI is passed through unchanged.
    # Resolving via a variable defers DNS lookup to request time, so nginx starts
    # even when the API container is not (yet) reachable.
    location /api {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build artifacts can be cached aggressively.
    location ~* \.(?:js|css|woff2?|ttf|png|jpg|jpeg|gif|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: route everything else to index.html for the Angular router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
